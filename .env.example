TELEGRAM_BOT_TOKEN=123456:ABC...
# чат менеджера для заявок: напишите боту /chatid в нужном чате (личка или группа)
MANAGER_CHAT_ID=
DB_PATH=data/tickets.db

# бесплатно: OpenRouter, ключ на https://openrouter.ai/settings/keys
LLM_PROVIDER=openrouter
LLM_API_KEY=sk-or-v1-...
LLM_MODEL=nvidia/nemotron-3.5-super-vl:free
LLM_BASE_URL=https://openrouter.ai/api/v1
# object = json_object; schema = json_schema (если модель поддерживает structured outputs)
LLM_JSON_MODE=object

